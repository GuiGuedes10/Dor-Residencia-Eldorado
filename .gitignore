# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Pytest / Test artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Generated runtime artifacts
artifacts/screenshots/
artifacts/metadata/
artifacts/*.png
artifacts/*.json
!artifacts/.gitkeep

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editor / IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Agent workspaces / internal orchestrator logs
.agents/
.gemini/

# Node.js (voice-nav-cli e extension)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Modelos binários grandes (baixados/treinados localmente — NÃO versionar)
# Whisper/ggml e afins; o classificador de tópicos (intent.json) É versionado.
voice-nav-cli/models/*.bin
voice-nav-cli/models/*.gguf
voice-nav-cli/models/ggml-*
*.onnx
*.pt
*.safetensors

# Mapas de site gerados pelo crawler (regeneráveis com `npm run map`)
voice-nav-cli/data/*.json
!voice-nav-cli/data/.gitkeep

# Áudios de captura temporários
*.wav
!tests/**/*.wav

# Fase 2 da extensão: Transformers.js + ONNX Runtime (baixados por extension/vendor/baixar.sh, ~22 MB)
extension/vendor/*.js
extension/vendor/*.mjs
extension/vendor/*.wasm
extension/vendor/modelo/

# Protótipo do classificador: splits gerados (regeneráveis) e modelo fine-tunado (grande)
prototipos/classificador-elementos/dataset_treino.json
prototipos/classificador-elementos/dataset_teste.json
prototipos/classificador-elementos/modelo-finetunado/
