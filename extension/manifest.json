{
  "manifest_version": 3,
  "name": "Dør",
  "description": "Controle flutuante acessível: fale o que procura e escolha entre até 4 links. Um halo de cor (vermelho→âmbar→azul) guia o mouse até o alvo certo.",
  "version": "1.1.0",
  "permissions": ["storage", "offscreen"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*", "https://cdn.jsdelivr.net/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["nn.js", "tfidf.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "train.html",
  "web_accessible_resources": [
    { "resources": ["models/intent.json"], "matches": ["https://*/*", "http://*/*"] }
  ]
}
